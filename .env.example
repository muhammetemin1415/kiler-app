# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kiler_dev"

# Authentication
JWT_SECRET="your-secret-key-at-least-32-characters-long-change-in-prod"
JWT_EXPIRE="24h"

# App Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"
NODE_ENV="development"

# Email Service (Nodemailer - Dev Config)
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@kiler-app.com"

# Optional: Production Email Service
# SENDGRID_API_KEY="your-sendgrid-key"
# AWS_SES_REGION="us-east-1"
